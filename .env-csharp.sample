# Environment for docker-compose.csharp.yml (the C# backend stack).
#
# Copy to .env-csharp (gitignored) and fill in every CHANGE_ME.
#   cp .env-csharp.sample .env-csharp
#   docker compose -f docker-compose.csharp.yml up -d
#
# This stack shares the MongoDB instance of the Python stack and joins its
# network. It does NOT create a database of its own.

# -----------
# Images and network
# -----------
# Pin a digest in real deployments: registry/img:tag@sha256:...
SHORELINE_IMAGE=shoreline-csharp:latest
NGINX_IMAGE=nginx:alpine
# Docker network created by the Python stack (see docker-compose.yml name).
MOEFLOW_EXTERNAL_NETWORK=moeflow-deploy_default

# Host ports bound on 127.0.0.1. Keep them clear of the Python stack
# (HTTP_PORT / HTTPS_PORT in .env).
CSHARP_API_PORT=5091
CSHARP_HTTP_PORT=5090

# Directory with the built SPA (index.html + assets/).
FRONTEND_BUILD_DIR=/mnt/c/Users/88888888/shoreline-moeflow/shoreline-moeflow-frontend/build
# nginx rejects uploads above this. Must be >= the app's own 1 GiB limit.
MAX_CONTENT_LENGTH_MB=1024

# -----------
# Database
# -----------
# Same instance as the Python stack; the service name resolves inside the
# external network. Credentials are the MONGODB_USER / MONGODB_PASS of .env.
MONGO_URI=mongodb://CHANGE_ME:CHANGE_ME@moeflow-mongodb:27017/moeflow?authSource=admin

# -----------
# Auth
# -----------
# MUST equal the legacy SECRET_KEY, otherwise every existing session token
# fails with {"error":"BadTokenError","code":1004}.
AUTH_SECRET=CHANGE_ME_32_CHARS_MINIMUM
AUTH_ADMIN_EMAIL=admin@example.com

# -----------
# Object storage (Cloudflare R2)
# -----------
# Local disk: STORAGE_TYPE=LOCAL, Storage__LocalRoot instead of these.
# Alibaba OSS is intentionally rejected by the C# backend.
STORAGE_TYPE=R2
STORAGE_ENDPOINT=https://CHANGE_ME.r2.cloudflarestorage.com
STORAGE_BUCKET=CHANGE_ME
STORAGE_ACCESS_KEY=CHANGE_ME
STORAGE_SECRET_KEY=CHANGE_ME
STORAGE_REGION=auto
# R2 is path-style; MinIO also needs true.
STORAGE_FORCE_PATH_STYLE=true
# Public download prefix, e.g. https://cdn.example.com/ (empty = presigned URLs).
STORAGE_DOMAIN=
STORAGE_VIA_CDN=false
STORAGE_KEY_PREFIX=

# -----------
# Mail
# -----------
MAIL_ENABLED=true
MAIL_HOST=smtp.example.com
MAIL_PORT=465
# Port 465 = implicit TLS.
MAIL_USE_SSL=true
MAIL_START_TLS=false
# Notification mail only. On 465 the legacy default (mandatory STARTTLS)
# fails, so set SslOnConnect. Verification-code mail follows MAIL_START_TLS.
# Allowed: None | Auto | StartTls | StartTlsWhenAvailable | SslOnConnect
MAIL_SECURE_SOCKET_OPTIONS=SslOnConnect
MAIL_FROM=noreply@example.com
MAIL_USERNAME=CHANGE_ME
MAIL_PASSWORD=CHANGE_ME

# -----------
# Site / CORS
# -----------
SITE_NAME=Moeflow
SITE_ORIGIN=https://example.com
# Public frontend origin, protocol included. Multiple: add CORS_ORIGIN_1 etc.
# in docker-compose.csharp.yml.
CORS_ORIGIN_0=http://127.0.0.1:5090

# -----------
# Worker tunables
# -----------
# Each slot is an async loop (~10 KB), not a process. 4 is plenty on 2 cores.
JOBS_CONCURRENCY=4
JOBS_MAX_ATTEMPTS=5
# The single backend container runs HTTP and the queue together. Set this to
# false only when you start the optional split worker profile.
JOBS_WORKER_ENABLED=true

# check = refuse to serve when a migration is pending (recommended once the
# database is up to date). apply = run migrations at startup (first deploy).
MIGRATIONS_MODE=check

# Off by default: these two scanners send mail and move objects against the
# live dataset. Enable deliberately.
NOTIFICATIONS_WORKER_ENABLED=false
STORAGE_POOL_WORKER_ENABLED=false

# Reverse proxy address, so X-Forwarded-For is trusted. Empty = trust none.
TRUSTED_PROXY_0=
